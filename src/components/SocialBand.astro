---
// Instagram section from the main site. With a Behold feed ID set in site.ts it
// shows the live @ggrooter grid; otherwise just the follow buttons.
import Icon from './Icon.astro';
import { business as b } from '../data/site';
---
<section class="social-band">
  <div class="wrap">
    <h2>See the Team at Work</h2>
    <p>Follow G&amp;G Rooter for real jobs, tough clogs, and life on the road.</p>
    {b.instagramFeedId && (
      <div class="ig-feed">
        <behold-widget feed-id={b.instagramFeedId}></behold-widget>
        <script is:inline type="module" src="https://w.behold.so/widget.js"></script>
      </div>
    )}
    <div class="actions">
      <a class="btn" href={b.social.Instagram} rel="noopener"><Icon name="instagram" />Follow @ggrooter</a>
      <a class="btn btn--outline" href={b.social.Facebook} rel="noopener"><Icon name="facebook" />Facebook</a>
    </div>
  </div>
</section>
