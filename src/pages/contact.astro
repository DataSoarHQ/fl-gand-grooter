---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CallbackForm from '../components/CallbackForm.astro';
import p from '../data/photos';
---
<Base title="Contact G&G Rooter | Drain and Sewer Service in Lee County, FL" crumb="Contact Us" description="Need drain or sewer help in Cape Coral, Fort Myers or anywhere in Lee County, FL? Call G&G Rooter at (239) 994-0524 or request a callback.">
  <PageHead image={p.plumbingCloseup} eyebrow="Request service in Lee County" title="Contact G&G Rooter" />
  <div class="yband" id="more"><h2>Fast Local Help</h2></div>
  <section class="band">
    <div class="wrap">
      <p class="center" style="max-width:44rem;margin:0 auto 2.5rem">Need help with a clogged drain, sewer backup, sewer inspection, water cleanup, or mold concern? Call now or request a callback.</p>
      <div class="wrap--narrow" style="width:min(100%,50rem);margin-inline:auto">
        <CallbackForm page="Contact" flat id="contact-form" />
      </div>
    </div>
  </section>
</Base>
