---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { faqGroups } from '../data/site';
import p from '../data/photos';

const schema = [{
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((g) => g.items).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') } })),
}];
---
<Base title="Drain, Sewer & Cleanup FAQs | G&G Rooter Lee County, FL" crumb="FAQs" extraSchema={schema} description="Answers about clogged drains, sewer backups, sewer inspections, septic lines, sewage cleanup, water cleanup and mold mitigation from G&G Rooter in Lee County, FL.">
  <PageHead image={p.cameraInspection} eyebrow="Questions about drain, sewer, cleanup, or mold issues?" title="Frequently Asked Questions" />
  <div id="more">
    {faqGroups.map((g, gi) => (
      <>
        <div class="yband"><h2>{g.title}</h2><a class="btn btn--black" href="/contact/">Get Help</a></div>
        <section class="section" style="padding-block:2rem 3rem">
          <div class="wrap--narrow faq" style="margin-inline:auto">
            {g.items.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <div class="faq__a">{f.a.map((t) => <p>{t}</p>)}</div>
              </details>
            ))}
          </div>
        </section>
      </>
    ))}
  </div>
</Base>
