---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import FastService from '../components/FastService.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Trusted from '../components/Trusted.astro';
import Reviews from '../components/Reviews.astro';
import AreaGrid from '../components/AreaGrid.astro';
import SocialBand from '../components/SocialBand.astro';
---
<Base
  title="Drain & Sewer Services in Cape Coral & Fort Myers, FL | G&G Rooter"
  description="Drain cleaning, sewer cleaning, sewer inspections, water damage cleanup and mold mitigation across Lee County, FL. Open 24/7. Call (239) 994-0524."
>
  <Hero
    eyebrow="Top-rated drain & sewer service, now in Lee County"
    title="Drain Cleaning &amp; Sewer Services in Cape Coral &amp; Fort Myers, FL"
  />
  <Marquee />
  <FastService />
  <ServiceCards />
  <Trusted />
  <Reviews />
  <AreaGrid text="From Cape Coral and Fort Myers to Bonita Springs, Lehigh Acres, and Pine Island, G&G Rooter serves all of Lee County. Find your community below." />
  <SocialBand />
</Base>
